# =========================
# AI STUDY BUDDY CLASS
# =========================

class AIStudyBuddy:

    def __init__(self):
        print("\n📚 AI Study Buddy Initialized!\n")

    # -------------------------
    # SEARCH RESEARCH PAPERS
    # -------------------------

    def search_research_papers(self, topic, max_results=5):

        print(f"\n🔎 Searching research papers for: {topic}\n")

        search = arxiv.Search(
            query=topic,
            max_results=max_results,
            sort_by=arxiv.SortCriterion.Relevance
        )

        papers = []

        for result in search.results():

            paper = {
                "title": result.title,
                "authors": [a.name for a in result.authors],
                "summary": result.summary,
                "pdf_url": result.pdf_url,
                "published": result.published.strftime("%Y-%m-%d")
            }

            papers.append(paper)

        return papers

    # -------------------------
    # SEARCH WEB ARTICLES
    # -------------------------

    def search_articles(self, topic, max_results=5):

        print(f"\n🌐 Searching articles for: {topic}\n")

        articles = []

        with DDGS() as ddgs:

            results = ddgs.text(
                keywords=topic,
                max_results=max_results
            )

            for r in results:

                articles.append({
                    "title": r.get("title"),
                    "url": r.get("href"),
                    "snippet": r.get("body")
                })

        return articles

    # -------------------------
    # SCRAPE ARTICLE CONTENT
    # -------------------------

    def scrape_article(self, url):

        try:

            headers = {
                "User-Agent": "Mozilla/5.0"
            }

            response = requests.get(url, headers=headers, timeout=10)

            soup = BeautifulSoup(response.text, "html.parser")

            paragraphs = soup.find_all("p")

            content = " ".join([p.get_text() for p in paragraphs])

            return content[:5000]

        except Exception as e:
            return f"Error scraping article: {e}"

    # -------------------------
    # AI SUMMARIZATION
    # -------------------------

    def summarize_text(self, text):

        print("\n🧠 Generating AI summary...\n")

        prompt = f"""
        Summarize the following study material clearly for a student.

        TEXT:
        {text}
        """

        response = client.chat.completions.create(
            model="gpt-4.1-mini",
            messages=[
                {
                    "role": "system",
                    "content": "You are an expert AI tutor."
                },
                {
                    "role": "user",
                    "content": prompt
                }
            ],
            temperature=0.4
        )

        return response.choices[0].message.content

    # -------------------------
    # ASK STUDY QUESTION
    # -------------------------

    def ask_question(self, question):

        print("\n🤖 Thinking...\n")

        response = client.chat.completions.create(
            model="gpt-4.1-mini",
            messages=[
                {
                    "role": "system",
                    "content": """
                    You are an intelligent study assistant.
                    Explain topics clearly and simply.
                    Use examples when helpful.
                    """
                },
                {
                    "role": "user",
                    "content": question
                }
            ],
            temperature=0.5
        )

        return response.choices[0].message.content

